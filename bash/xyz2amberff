#!/bin/bash

set -eu

function help(){
	option_help
}

function option_help(){
cat <<EOF
    -h, -help, --help | display this help
    -i, --xyz | xyz file path
    -c, --charge | charge
    -m, --multiplicity | multiplicity
    -at | force-field (available: gaff, gaff2, amber, bcc, sybyl)
    --scf | electronic state theory for ESP calculation
    --basis | basis set for ESP calculation
    --octet-charge | specify charge of the molecule in its closed shell state
    --modify-bond | modify bond section in mol2 file generated by antechamber

EOF
}

# set default
charge=0
multi=1
octetcharge=
scf=HF
basis='6-31G(d)'
modifyBond=false


# parse options
while [ "$#" -gt 0 ] ;
do
	case "$1" in
	-h | -help | --help)
		help
		exit
		;;
	-i | --xyz)
		xyzFile="$2"
		shift 2
		;;
	-c | --charge)
		charge="$2"
		shift 2
		;;
	-at)
		forceField="$2"
		shift 2
		;;
	--octet-charge)
		octetcharge="$2"
		shift 2
		;;
	--modify-bond)
		modifyBond=true
		shift 1
		;;
	-m | --multiplicity)
		multi="$2"
		shift 2
		;;
	--scf)
		scf="$2"
		shift 2
		;;
	--basis)
		basis="$2"
		shift 2
		;;
	-*)
		error "unknown option: '$*'"
		;;
	*)
		break
		;;
	esac
done

if [ ! "$octetcharge" ]; then
	octetcharge="$charge"
fi


xyzFile="$1"
gjfFile=resp.gjf
glogFile=resp.log
mol2File=resp.mol2


xyz2gjf --link0 '%chk=resp.chk' \
		--route "opt ${scf}/${basis}" \
		--title 'auto-generated gjf by xyz2amberff' \
		--charge "$charge" \
		--multi "$multi" \
		--resp
		-O "$gjfFile"

# ESP計算
g16 "$gjfFile" > "$glogFile"

# mol2生成(RESP電荷生成)
antechamber -i "$glogFile" -fi gout -o "$mol2File" -fo mol2 -c resp -nc "$charge" -m "$multi" -at "$forceField"

if "$modifyBond"; then
	# mol2修正
	python <<EOF
from chemscripts.mol2 import Mol2
mol2 = Mol2('$mol2File')
mol2.modifyBondTypeForAntechamber(octetcharge=$octetcharge)
mol2.write('$mol2File')

EOF
fi

# force field生成
antechamber -i "$mol2File" -fi mol2 -o prepin -fo prepi -at "$forceField"
parmchk2 -a Y -i prepin -f prepi -o frcmod


